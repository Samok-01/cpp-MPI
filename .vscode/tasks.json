{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "MPI: Build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\mpic++.exe",
            "args": [
                "-fopenmp",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\Program Files\\Microsoft MPI\\Bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Компилирует текущий открытый файл через mpic++ (Ctrl+Shift+B)"
        },
